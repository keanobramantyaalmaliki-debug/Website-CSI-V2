# Salin jadi `.env` lalu isi. `.env` tidak pernah masuk git.

# Postgres lokal (Postgres.app, cluster di ~/Library/Application Support/Postgres/var-17)
DATABASE_URL=postgres://keano@localhost:5432/cogniti_dev
# Dipakai test API — ISINYA DIHAPUS setiap kali test jalan, jangan diarahkan ke dev
TEST_DATABASE_URL=postgres://keano@localhost:5432/cogniti_test

# Kunci penanda tangan cookie sesi. Bikin baru dengan:
#   openssl rand -base64 32
SESSION_SECRET=ganti-aku

# Port proses API
PORT=3001

# Purge cache Cloudflare setelah publish (kosongkan di lokal — publish tetap jalan)
CF_ZONE_ID=
CF_PURGE_TOKEN=
