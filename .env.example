# Salin jadi `.env` lalu isi. `.env` tidak pernah masuk git.

# Postgres lokal di Docker (stack "cogniti-db" di Portainer, container cogniti-postgres).
# Host ditulis 127.0.0.1, BUKAN localhost: port-forward Docker cuma mengikat IPv4,
# sementara "localhost" di macOS dipetakan ke ::1 lebih dulu.
DATABASE_URL=postgres://keano@127.0.0.1:5432/cogniti_dev
# Dipakai test API — ISINYA DIHAPUS setiap kali test jalan, jangan diarahkan ke dev
TEST_DATABASE_URL=postgres://keano@127.0.0.1:5432/cogniti_test

# Kunci penanda tangan cookie sesi. Bikin baru dengan:
#   openssl rand -base64 32
SESSION_SECRET=ganti-aku

# Port proses API
PORT=3001

# Purge cache Cloudflare setelah publish (kosongkan di lokal — publish tetap jalan)
CF_ZONE_ID=
CF_PURGE_TOKEN=
