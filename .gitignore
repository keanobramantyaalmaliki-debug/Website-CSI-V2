# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# vite output
/dist

# production
/build

# next.js
/.next/
next-env.d.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# foto & referensi (lokal saja, ukurannya besar)
/Photo-reference-office/
/Front-desk-Photo/
/reference/

# model 3D hasil export (besar, di-generate dari Blender — jangan di-track)
export-test/*.glb

# office.glb TIDAK lagi di-track (19 Agu): 13MB memberati repo & tiap update model
# memaksa commit+rebuild. Kini tinggal di /3d/models (root) dan disajikan oleh
# plugin serveLocalModels di vite.config.ts (dev & preview); di produksi path
# /3d/models/* diambil alih reverse proxy → MinIO. GLB kecil tetap di public/.
/3d/

/.claude/

# manajer paket: project ini pakai BUN. Lockfile lain jangan ikut ter-commit —
# dua lockfile berbeda manajer bikin tiap orang install & saling menimpa.
pnpm-lock.yaml
package-lock.json
yarn.lock

/.agents/

# lab / prototype pages — dev-only, tidak masuk production
lab.html
matterjs-lab.html
/src/lab/
/src/components/lab/
/src/lib/lab/
/src/lib/hooks/useMatterLab.ts

# Screenshot sumber untuk konten layar (src/components/canvas/screens.ts).
# Isinya tangkapan layar akun pribadi — nama akun, playlist, riwayat dengar —
# dan repo ini publik. Yang di-commit HANYA hasil pixelasinya di public/screens/
# (96×54, sudah tidak terbaca). Simpan sumbernya lokal saja.
/Screenshot *.png

# Artefak pipeline bake (5 Agu) — sumber EXR & render antara, ratusan MB.
# Hasil akhirnya (office.glb) kini di /3d/models, di luar git — lihat blok di atas.
/bake-output/
*.glb.bak-*
*.test-shrink.glb

# Keluaran default scripts/shoot.mjs.
/shot.png
